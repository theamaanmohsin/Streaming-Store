# TMDB API Key (get from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_API_KEY=your_tmdb_api_key_here

# Firebase Web App settings (Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=streaming-store-21a6a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=streaming-store-21a6a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=streaming-store-21a6a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Optional: Analytics, etc.
# NEXT_PUBLIC_GA_ID=
